{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxa",
  "version": "0.1.14",
  "identifier": "local.voxa.translate",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main", "title": "Voxa", "width": 960, "height": 720,
        "minWidth": 600, "minHeight": 560,
        "titleBarStyle": "Overlay", "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 25 }
      }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; base-uri 'none'; form-action 'none'" }
  },
  "bundle": { "active": true, "targets": ["app"], "macOS": { "minimumSystemVersion": "14.2" } }
}
